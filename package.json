{
  "name": "iotconnector",
  "private": true,
  "version": "0.1.0",
  "description": "Factory Bridge - IIoT Edge Gateway Platform (console + gateway runtime)",
  "scripts": {
    "dev": "concurrently -n gateway,console -c blue,green \"pnpm --filter @iotconnector/gateway dev\" \"pnpm --filter @iotconnector/console dev\"",
    "dev:console": "pnpm --filter @iotconnector/console dev",
    "dev:gateway": "pnpm --filter @iotconnector/gateway dev",
    "dev:modbus-sim": "pnpm --filter @iotconnector/gateway modbus-sim",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/mqtt": "^2.5.0",
    "concurrently": "^9.1.2",
    "vitest": "^5.0.0"
  }
}