# 本文件仅作参考，内容为 factorybridge service install 生成的单元（Linux，默认服务名 factorybridge、运行账号 factorybridge）。
# 推荐做法：sudo factorybridge service install --data-dir /var/lib/factorybridge -- --host 0.0.0.0 --allow-cidr 10.0.0.0/8
#   该命令把单元写入 /etc/systemd/system/factorybridge.service（见 apps/gateway-go/cmd/factorybridge/service_linux.go 的 unitPath）。
# 若手工安装，请按实际路径调整 ExecStart、ReadWritePaths，然后执行 systemctl daemon-reload 与 systemctl enable --now factorybridge。
# 由 factorybridge service install 生成；修改参数请 uninstall 后重新 install
[Unit]
Description=FactoryBridge IIoT edge gateway (factorybridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=factorybridge
Group=factorybridge
ExecStart="/opt/factorybridge/factorybridge" "run" "--data-dir" "/var/lib/factorybridge" "--host" "0.0.0.0" "--allow-cidr" "10.0.0.0/8"
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5
KillSignal=SIGINT
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths="/var/lib/factorybridge"
# 监听 1024 以下端口（如 443）时需要；默认端口 18080 用不到
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
