# Factory Bridge 网关环境变量参考（apps/gateway-go）
#
# 网关从进程环境变量读取这些配置，不会自动加载 .env 文件（仓库内没有 dotenv 加载代码）。
# 启动前请用 export 设置，或由服务管理器 / 容器注入。
# 同时设置环境变量和命令行参数时，命令行参数优先：环境变量只是对应 flag 的默认值
# （见 apps/gateway-go/cmd/factorybridge/cli.go 的 cmdRun）。
#
# 以下均为注释掉的示例，取值为代码中的默认值。密码和令牌类变量留空，需要时自行填写，
# 不要把真实密钥提交到仓库。

# ---- 运行与监听 ----

# 数据目录（config.json、auth.json、outbox 等）。命令行参数：--data-dir
# 未指定时：在仓库内运行用 apps/gateway-go/data，否则用可执行文件旁的 data/（见 cmd/factorybridge/datadir.go）。
# 默认目录首次启动且为空时，会从旧 Node 目录 apps/gateway/data 复制一份状态；显式指定则不导入。
# GATEWAY_GO_DATA_DIR=apps/gateway-go/data

# HTTP 监听端口。命令行参数：--port
# GATEWAY_GO_PORT=18080

# 监听地址。开发模式下强制为 127.0.0.1。命令行参数：--host
# GATEWAY_GO_HOST=127.0.0.1

# 日志级别：debug | info | warn | error。命令行参数：--log-level
# GATEWAY_GO_LOG_LEVEL=info

# 控制台静态文件目录（需含 index.html）。留空则只提供 API。命令行参数：--web-dir
# 代码默认：可执行文件旁的 web 目录，或 apps/console/dist、../console/dist 中第一个存在的目录
# GATEWAY_GO_WEB_DIR=

# 开发模式：自动创建开发账号、放行 localhost 来源、只允许回环地址。命令行参数：--dev
# GATEWAY_GO_DEV=false

# TLS 证书（PEM）文件路径。监听非回环地址且未指定时自动生成自签名证书。命令行参数：--tls-cert
# GATEWAY_GO_TLS_CERT=

# TLS 私钥（PEM）文件路径。命令行参数：--tls-key
# GATEWAY_GO_TLS_KEY=

# 允许访问的客户端网段，逗号分隔，例如 10.0.0.0/8,192.168.1.20。回环地址始终允许。命令行参数：--allow-cidr
# GATEWAY_GO_ALLOW_CIDRS=

# 允许浏览器跨域访问的来源，逗号分隔。
# GATEWAY_GO_CORS_ORIGINS=

# 由 Windows 服务管理器或 systemd 设置，手动运行时不要设置。设置后禁止进入开发模式。
# FB_SERVICE=
# INVOCATION_ID=

# ---- 认证 ----

# 登录会话有效期，Go duration 格式，例如 8h。无效或不大于 0 时使用 8h（见 internal/auth/users.go）
# GATEWAY_GO_SESSION_TTL=8h

# 开发模式下开发账号 dev 的密码（需满足口令策略）。留空则每次启动随机生成（见 cmd/factorybridge/users.go ensureDevAccount）。
# FB_DEV_PASSWORD=

# 静态 API 令牌，按角色授权。留空表示不启用。GATEWAY_GO_API_TOKEN 映射为 operator 角色（见 internal/api/server.go）。
# GATEWAY_GO_API_TOKEN=
# GATEWAY_GO_VIEWER_TOKEN=
# GATEWAY_GO_OPERATOR_TOKEN=
# GATEWAY_GO_ADMIN_TOKEN=

# ---- 存储 / TDengine ----

# TDengine 连接地址。留空则不连接 TDengine，并且不生成 outbox.json 离线队列。
# TDENGINE_URL=

# TDengine 用户名
# TDENGINE_USER=root

# TDengine 密码。设置 TDENGINE_URL 时必填；网关不提供内置默认密码，未设置则拒绝启动。
# TDENGINE_PASSWORD=

# TDengine 数据库名
# TDENGINE_DB=factory_bridge

# 超级表名
# TDENGINE_STABLE=st_factory_equipment

# 离线缓存队列（outbox）的最大条目数，超过后丢弃最旧的点。
# GATEWAY_GO_OUTBOX_MAX=100000

# ---- 脚本 ----

# 设为 1 时脚本在网关进程内执行，不使用隔离子进程。默认不设置，即使用隔离子进程。
# GATEWAY_GO_SCRIPT_INLINE=

# 脚本隔离子进程标记。网关会自行设置为 1，手动运行时不要设置。
# GATEWAY_GO_SCRIPT_WORKER=

# ---- 驱动 ----

# 设为 go 时，Modbus TCP、Siemens Profinet、Mitsubishi MELSEC 通道自动路由到 Go 驱动。
# 通道中显式指定 params.driver 的优先。
# GATEWAY_GO_DRIVER_MODE=

# ---- 测试脚本 ----
# 以下变量供 scripts/ 和 e2e/ 下的测试脚本使用，不被网关读取。

# 登录用户名，默认 admin
# GATEWAY_USER=admin

# 登录密码，必填。留空，需要时自行填写。
# GATEWAY_PASSWORD=

# e2e 登录用户名，默认 admin，未设置时回退到 GATEWAY_USER
# E2E_USER=admin

# e2e 登录密码，必填，未设置时回退到 GATEWAY_PASSWORD。留空，需要时自行填写。
# E2E_PASSWORD=
