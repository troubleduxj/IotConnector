{
  "name": "iotconnector",
  "private": true,
  "version": "0.1.0",
  "description": "Factory Bridge - IIoT Edge Gateway Platform (console + gateway runtime)",
  "scripts": {
    "dev": "pnpm --filter @iotconnector/console dev",
    "dev:console": "pnpm --filter @iotconnector/console dev",
    "dev:gateway": "cd apps/gateway-go && go run ./cmd/factorybridge run --dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:docker": "node scripts/e2e-docker.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vitest": "^5.0.0"
  }
}
